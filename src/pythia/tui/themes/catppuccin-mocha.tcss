/* ── Catppuccin Mocha — Identical to canonical dark theme ── */

/* ── Layout ── */

Screen {
    layout: vertical;
    background: #1e1e2e;
}

SearchScreen {
    layout: vertical;
    background: #1e1e2e;
}

LogoBanner {
    padding: 1 0;
    margin: 0 0 1 0;
    content-align: center middle;
}

/* ── Results ── */

#results-area {
    height: 1fr;
    border: round #89b4fa;
    padding: 1 2;
    overflow-y: auto;
    background: #1e1e2e;
}

ResultCard {
    padding: 0 1;
    margin: 0;
    height: auto;
}

SourceList {
    height: auto;
    padding: 0 1;
    margin: 1 0 0 0;
}

CacheBadge {
    height: 1;
    padding: 0 1;
    margin: 1 0 0 0;
}

ActivityIndicator {
    height: 1;
    padding: 0 1;
    margin: 0;
}

/* ── Search Input ── */

SearchInput {
    height: auto;
    min-height: 3;
    max-height: 5;
    border-top: solid #89b4fa;
    padding: 0 1;
    background: #181825;
}

SearchInput Input {
    background: #181825;
    border: none;
}

/* ── Status Bar ── */

PythiaStatusBar {
    height: 1;
    dock: bottom;
    background: #313244;
    color: #6c7086;
    padding: 0 1;
}

/* ── Research Tree ── */

.node-pending { color: #585b70; }
.node-searching { color: #89dceb; }
.node-complete { color: #a6e3a1; }
.node-active { color: #cdd6f4; text-style: bold; }
.node-dim { color: #6c7086; }

/* ── Tabs ── */

.tab-active { background: #1e1e2e; color: #89dceb; text-style: bold; }
.tab-inactive { color: #6c7086; }

/* ── Mode Label ── */

.mode-label { color: #f9e2af; text-style: bold; }
.mode-label-off { color: #585b70; }

/* ── Session Divider ── */

SessionDivider { height: 1; margin: 1 0; color: #89b4fa; }

/* ── Research Layout ── */

#research-tree-pane { width: 30; border-right: solid #89b4fa; }
#research-main-pane { width: 1fr; }
ResearchProgressBar { height: 1; padding: 0 1; background: #313244; }

/* ── History ── */

HistoryList { height: 1fr; }
.history-cache-hit { color: #a6e3a1; }
.history-web-search { color: #89dceb; }
.history-research { color: #cba6f7; }

/* ── Dashboard ── */

StatsPanel { height: auto; padding: 1 2; border: round #89b4fa; }
SparklinePanel { height: 5; padding: 1 2; border: round #89b4fa; }
SettingsPanel { height: auto; padding: 1 2; border: round #89b4fa; }
ActionBar { height: 3; padding: 0 2; }

/* ── Service Status ── */

ServiceStatusIndicator { height: auto; max-height: 2; dock: bottom; background: #313244; color: #6c7086; padding: 0 2; }
