/* Pythia — an amber research instrument. Theme tokens keep every mode coherent. */
Screen { layout: vertical; background: $background; color: $text; }
SearchScreen { layout: vertical; padding: 0 2; }
LogoBanner { height: 9; padding: 1 2; margin: 0; content-align: left middle; }
#results-area {
    height: 1fr;
    border: round $primary 35%;
    border-title-color: $primary;
    padding: 1 2;
    overflow-y: auto;
    background: $surface;
}
ResultCard { padding: 0 1; margin: 0; height: auto; }
SourceList { height: auto; padding: 0 1; margin: 1 0 0 0; }
CacheBadge { height: 1; padding: 0 1; margin: 1 0 0 0; }
ActivityIndicator { height: 1; padding: 0 1; margin: 0; }
SearchInput { height: auto; min-height: 3; max-height: 5; border: round $primary; padding: 0 1; background: $surface; margin-top: 1; }
SearchInput Input { background: $surface; border: none; }
SearchInput:focus-within { border: round $accent; }
PythiaStatusBar { height: 1; dock: bottom; background: $panel; color: $text-muted; padding: 0 1; }
.node-pending { color: $text-disabled; }
.node-searching { color: $accent; }
.node-complete { color: $success; }
.node-active { color: $text; text-style: bold; }
.node-dim { color: $text-muted; }
.tab-active { background: $surface; color: $primary; text-style: bold; }
.tab-inactive { color: $text-muted; }
.mode-label { color: $warning; text-style: bold; }
.mode-label-off { color: $text-disabled; }
SessionDivider { height: 1; margin: 1 0; color: $primary; }
#research-tree-pane { width: 32; border-right: solid $primary 35%; background: $surface; }
#research-main-pane { width: 1fr; padding: 0 1; }
ResearchProgressBar { height: 1; padding: 0 1; background: $panel; }
HistoryList { height: 1fr; }
.history-cache-hit { color: $success; }
.history-web-search { color: $accent; }
.history-research { color: $secondary; }
DashboardScreen { padding: 1 2; }
StatsPanel { height: auto; padding: 1 2; border: round $primary 35%; background: $surface; }
SparklinePanel { height: 7; padding: 1 2; border: round $primary 35%; background: $surface; }
SettingsPanel { height: auto; padding: 1 2; border: round $primary 35%; margin-top: 1; }
ActionBar { height: 3; padding: 0 2; margin-top: 1; }
ServiceStatusIndicator { height: auto; max-height: 2; dock: bottom; background: $panel; color: $text-muted; padding: 0 2; }
